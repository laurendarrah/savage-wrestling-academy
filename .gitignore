# Reconstructed 2026-11-05. The original .gitignore was dropped by the Drive upload.
# Replace with Justin's original if it differs.

# Dependencies and package-manager state
node_modules/
.sites-runtime/

# Build output and caches
dist/
.next/
.vinext/
.wrangler/
next-env.d.ts
*.tsbuildinfo

# Secrets. Never commit real credentials.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# OS and editor noise
.DS_Store
*.log
!handoff/**/*.log

# Browser walkthrough output (pnpm e2e): screenshots, screenshots of failed steps, and the log CI keeps
e2e-screenshots/
e2e-failures/
e2e-walkthrough.log

# Working copies made by Claude Code helpers; never part of the project.
.claude/worktrees/

# Dependencies and the pnpm store (pnpm-workspace.yaml keeps the store in .sites-runtime/pnpm-store)
node_modules/
.sites-runtime/

# Build output and caches
dist/
.next/
.vinext/
next-env.d.ts
*.tsbuildinfo
coverage/

# Local Wrangler state: pnpm start's database (.wrangler/state), the walkthrough's and payment rehearsal's databases
# and server logs (.wrangler/e2e*), and the restore drill's local copy (.wrangler/restore-drill)
.wrangler/

# Secrets. Never commit real credentials.
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*

# Backup files hold real family records. Only the test fixtures, made from test data, belong in the repository.
*.savage
!tests/fixtures/backups/*.savage

# OS and editor noise
.DS_Store
*.log
!docs/archive/**/*.log

# Browser walkthrough output (pnpm e2e): screenshots, screenshots of failed steps, and the log CI keeps
e2e-screenshots/
e2e-failures/
e2e-walkthrough.log

# Working copies made by Claude Code helpers; never part of the project.
.claude/worktrees/

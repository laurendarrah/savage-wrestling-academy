# Reconstructed 2026-11-05 from handoff/docs/SETUP.md. The original file was dropped by the Drive upload.
# Copy to .env.local and fill in values from a SEPARATE development Supabase project.
# Never use production credentials for local development.

SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-dev-publishable-key

# 32 random bytes as 64 hex characters. Only needed to test Stripe test-key storage.
# Generate with: openssl rand -hex 32
STRIPE_CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters

# Signing secret of the Stripe webhook endpoint for /api/stripe-webhook (starts with whsec_).
# Orders only become paid through verified webhooks, so checkout stays closed without it.
STRIPE_TEST_WEBHOOK_SECRET=

# "test" (default) or exactly "live". Live keys are accepted, and live cards charged, only in live mode.
STRIPE_MODE=test

# Signing secret of the LIVE Stripe webhook endpoint for /api/stripe-webhook. Required for live checkout.
STRIPE_LIVE_WEBHOOK_SECRET=

# Optional. The Stripe account every key must belong to. Defaults to the Savage Wrestling Academy LLC test account.
# STRIPE_ACCOUNT_ID=acct_...

# Purchase types open for online payment, comma separated. Empty means checkout is closed.
# Allowed: walkin, annual, monthly, event, live. List monthly only after the membership terms are approved.
# The restricted Stripe key needs Checkout Sessions: Write, and Subscriptions: Write for monthly memberships.
# The webhook endpoint must send checkout.session.*, charge.refunded, invoice.paid, invoice.payment_failed
# and customer.subscription.deleted.
CHECKOUT_KINDS=

# Origin used in sign-up and password-reset email links. Must be in the Supabase Auth redirect allowlist.
# Defaults to the live Sites hostname when unset. Must be https, except localhost and 127.0.0.1.
APP_ORIGIN=http://127.0.0.1:5173

# OWNER_EMAIL is still hard-coded in lib/account-auth.ts. An environment variable with that name has no effect.

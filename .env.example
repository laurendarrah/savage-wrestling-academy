# Every setting the code reads, with placeholders only. Never put real values in this file: the repository is public.
# Copy to .env.local for local development and fill in a SEPARATE development Supabase project. Never use production
# credentials locally. On the live site these are Worker settings in Cloudflare (docs/GO_LIVE.md, step 2).

# --- Sign-in (Supabase Auth, sign-in only) ---
SUPABASE_URL=https://your-dev-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=replace-with-dev-publishable-key

# Required. The site's address, used in sign-up, password-reset and invite email links and in page metadata. There is
# no default: without it those emails fail with a clear error. Must be https, except localhost and 127.0.0.1, and must
# be in the Supabase Auth redirect allowlist.
APP_ORIGIN=http://127.0.0.1:5173

# Optional, before launch only. "off" lets the owner and coaches sign in without an authenticator (#204); anyone who
# has set one up still uses it. Delete it to require the authenticator again (#27). The launch checklist shows it in red.
# STAFF_MFA=off

# --- Payments (Stripe) ---
# 32 random bytes as 64 hex characters. Encrypts the restricted Stripe key saved on /payment-setup.
# Generate with: openssl rand -hex 32
STRIPE_CONFIG_ENCRYPTION_KEY=replace-with-64-hex-characters

# "test" (default) or exactly "live". Live keys are accepted, and live cards charged, only in live mode.
STRIPE_MODE=test

# Signing secret of the TEST Stripe webhook endpoint for /api/stripe-webhook (starts with whsec_).
# Orders only become paid through verified webhooks, so checkout stays closed without the secret for the current mode.
STRIPE_TEST_WEBHOOK_SECRET=

# Signing secret of the LIVE Stripe webhook endpoint for /api/stripe-webhook. Required for live checkout.
STRIPE_LIVE_WEBHOOK_SECRET=

# Optional, usually unset. Pins the Stripe account every key must belong to. Without it, the first test key saved and
# confirmed on /payment-setup decides the account (#255).
# STRIPE_ACCOUNT_ID=acct_...

# Purchase types open for online payment, comma separated. Empty means checkout is closed.
# Allowed: walkin, monthly, event, live, lesson. List monthly only after the membership terms are approved (#2), and
# the others only once their refund policy is decided (#3). A year paid upfront ("annual") is not offered (#210) and is
# ignored if listed.
# The restricted Stripe key needs Checkout Sessions: Write, Subscriptions: Write for monthly memberships, and
# Balance: Read for card fees. The webhook endpoint must send checkout.session.*, charge.refunded, invoice.paid,
# invoice.payment_failed and customer.subscription.deleted.
CHECKOUT_KINDS=

# Local payment rehearsal only (pnpm e2e:payments sets it). Sends TEST-mode Stripe calls to stripe-mock on this machine.
# Ignored in live mode and for any host that is not localhost or 127.0.0.1.
# STRIPE_API_BASE=http://127.0.0.1:12111

# --- Email (Resend) ---
# Both unset means no email: messages stay in the app and each recipient is marked "skipped". From Justin's own Resend
# account (#35, #87).
# EMAIL_API_KEY=
# MAIL_FROM=Savage Wrestling Academy <noreply@your-verified-domain>

# --- USA Wrestling card lookup ---
# Tests and the walkthrough only. Unset on the live site, where lookups go to USA Wrestling's public verify page.
# USAW_LOOKUP_BASE=http://127.0.0.1:54331

# --- Build and deploy (read by vite.config.ts; the Deploy workflow sets them, not .env.local) ---
# WORKER_NAME=savage-wrestling-academy
# D1_DATABASE_ID=          # the live database's id; locally a fixed throwaway id is used
# D1_DATABASE_NAME=savage-wrestling-academy

# OWNER_EMAIL is hard-coded in lib/account-auth.ts. An environment variable with that name has no effect.
